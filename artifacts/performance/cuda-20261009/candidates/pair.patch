+@wp.func
+def pair_distant(p: wp.vec3, q: wp.vec3, guard: float):
+    # Scaling both squares by (1 + guard) increases every summed SAT support
+    # by at least guard. Their circumcircles then bound the contact region.
+    # The squared-distance margin covers FP32 SAT/trigonometry rounding.
+    # Keep exceptional and extreme inputs on the original numerical path.
+    dx = q[0] - p[0]
+    dy = q[1] - p[1]
+    distance_squared = dx * dx + dy * dy
+    extent = 1.0 + guard
+    return (distance_squared > 2.0 * extent * extent + 0.001
+            and distance_squared < 1000000.0
+            and wp.abs(p[2]) <= 10000.0 and wp.abs(q[2]) <= 10000.0)
+
